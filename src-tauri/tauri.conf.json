{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyPhotoPrint",
  "version": "0.1.18",
  "identifier": "com.bitflip.easyphotoprint",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "EasyPhotoPrint",
        "label": "main",
        "width": 1400,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Patrick Weiss",
    "homepage": "https://github.com/bitflip55/EasyPhotoPrint",
    "category": "Graphics and Design",
    "shortDescription": "A lightweight modern photo layout and print desktop app, inspired by classic tools such as PhotoPrint.",
    "longDescription": "EasyPhotoPrint is a lightweight modern photo layout and print desktop app, inspired by classic tools such as PhotoPrint, with configurable formats, grids, margins, spacing, multi-page PDF export and system printing.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/512x512.png"
    ],
    "fileAssociations": [
      {
        "ext": [
          "png"
        ],
        "mimeType": "image/png",
        "name": "PNG Image"
      },
      {
        "ext": [
          "jpg",
          "jpeg"
        ],
        "mimeType": "image/jpeg",
        "name": "JPEG Image"
      },
      {
        "ext": [
          "webp"
        ],
        "mimeType": "image/webp",
        "name": "WebP Image"
      },
      {
        "ext": [
          "gif"
        ],
        "mimeType": "image/gif",
        "name": "GIF Image"
      },
      {
        "ext": [
          "bmp"
        ],
        "mimeType": "image/bmp",
        "name": "Bitmap Image"
      }
    ],
    "linux": {
      "deb": {
        "section": "graphics",
        "desktopTemplate": "linux/easy-photo-print.desktop.hbs",
        "depends": [
          "libgtk-3-0",
          "libwebkit2gtk-4.1-0",
          "libjavascriptcoregtk-4.1-0",
          "libsoup-3.0-0",
          "libayatana-appindicator3-1",
          "libxdo3"
        ],
        "files": {
          "/usr/share/metainfo/com.bitflip.easyphotoprint.metainfo.xml": "linux/com.bitflip.easyphotoprint.metainfo.xml"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/easy-photo-print.desktop.hbs",
        "files": {
          "/usr/share/metainfo/com.bitflip.easyphotoprint.metainfo.xml": "linux/com.bitflip.easyphotoprint.metainfo.xml"
        }
      }
    }
  }
}
