{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Easy Photo Print",
  "version": "0.1.0",
  "identifier": "com.bitflip.easyphotoprint",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Easy Photo Print",
        "label": "main",
        "width": 1400,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
